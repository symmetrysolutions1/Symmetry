{
  "name": "symmetry-enterprises",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @symmetry/api-gateway dev",
    "lint": "pnpm -r lint",
    "test": "node --test tests/canonical-evidence.test.mjs tests/backend-services.test.cjs",
    "test:e2e": "pnpm --filter @symmetry/api-gateway test:e2e",
    "test:backend": "node --test tests/backend-services.test.cjs",
    "test:evidence": "node --test tests/canonical-evidence.test.mjs",
    "contracts:test": "forge test",
    "contracts:fmt": "forge fmt",
    "contracts:fmt:check": "forge fmt --check",
    "contracts:build": "forge build",
    "contracts:sizes": "forge build --sizes --skip test --skip script",
    "contracts:check": "node scripts/ops/compile-solidity.mjs",
    "readiness:check": "node scripts/ops/check-production-readiness.mjs",
    "readiness:testnet": "node scripts/ops/check-production-readiness.mjs --tier=testnet",
    "readiness:production": "node scripts/ops/check-production-readiness.mjs --tier=production",
    "readiness:live": "node scripts/ops/check-live-deployment.mjs",
    "enterprise:provision": "node scripts/ops/provision-enterprise-root.mjs",
    "deploy:plan": "node scripts/ops/build-deployment-plan.mjs",
    "deploy:artifact": "node scripts/ops/write-deployment-artifact.mjs",
    "deploy:artifact:validate": "node scripts/ops/validate-deployment-artifact.mjs",
    "evidence:manifest": "node services/evidence-normalizer/build-evidence-manifest.mjs",
    "evidence:prepare": "node services/evidence-normalizer/prepare-evidence-anchor.mjs",
    "evidence:finalize": "node services/evidence-normalizer/finalize-evidence-manifest.mjs",
    "evidence:health": "node services/evidence-normalizer/check-evidence-health.mjs",
    "indexers:envelope": "node indexers/chain-listener/build-event-envelope.mjs",
    "indexers:poll": "node indexers/chain-listener/poll-chain-events.mjs",
    "deploy:record-factory": "node scripts/ops/record-factory-broadcast.mjs",
    "deploy:check-verification": "node scripts/ops/check-explorer-verification.mjs"
  },
  "devDependencies": {
    "js-sha3": "0.8.0",
    "solc": "^0.8.35"
  }
}
